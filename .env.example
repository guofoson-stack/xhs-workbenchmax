# 复制一份改名为 .env.local，填好下面的值（用记事本打开就能改）

# ---------- 大模型（必填）----------
# 任意 OpenAI 兼容接口都行；拆解封面需要能看图的模型
# 通义千问（阿里云百炼控制台 → API-KEY）：
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-在这里填你的key
AI_MODEL=qwen-vl-max

# 生成文案可以换一个更会写的模型（同一个平台下的），不填就用上面那个
# 例如通义千问：qwen-max
AI_TEXT_MODEL=

# ---------- 登录密码（可选）----------
# 只在办公室局域网用，可以留空 = 不需要登录
# 如果开了内网穿透让外面的人访问，一定要设置
APP_PASSWORD=

# ---------- 小红书抓取（可选）----------
# 粘贴链接抓不到内容时再填：电脑浏览器登录小红书网页版 → 按 F12 → 「网络/Network」→ 刷新页面
# → 点第一个请求 → 在「请求标头」里找到 cookie，把后面一整串复制到这里
XHS_COOKIE=
