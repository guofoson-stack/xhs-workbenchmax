# 复制为 .env.local 后填写；部署到 Vercel 时在项目 Settings → Environment Variables 里填同样的值

# 内部登录密码（团队共用）
APP_PASSWORD=换成你们自己的密码

# Supabase：控制台 → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=只放在服务端，不要泄露

# 大模型：任意 OpenAI 兼容接口，必须支持看图（拆封面用）
# 通义千问示例：
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-xxxx
AI_MODEL=qwen-vl-max
# 生成文案可以用另一个更擅长写作的模型，不填就用上面那个
AI_TEXT_MODEL=
